{
  "name": "dsh-composer-bottom",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: dock the home composer card at the bottom of the conversation column, keep the fish logo centered, and match the active composer geometry exactly. Auto-reverts on disable.",
  "license": "MIT",
  "author": "zhenhuilv",
  "homepage": "https://github.com/zhenhuilv/dsh-composer-bottom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhenhuilv/dsh-composer-bottom.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "composer",
    "ui"
  ],
  "private": false,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": { "dsh": ">=0.2.2-rc.5" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
